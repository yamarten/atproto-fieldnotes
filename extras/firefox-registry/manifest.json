{
  "manifest_version": 3,
  "name": "Project Registry",
  "version": "0.2.0",
  "description": "見ているサービスから、自分のProject Registryで登録確認とフィードバックへ進みます。",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Project Registry",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "background": {"scripts": ["entry.js", "background.js"]},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "browser_specific_settings": {
    "gecko": {
      "id": "project-registry@atproto-survey.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["browsingActivity"]}
    }
  }
}
