{
  "version": 1,
  "cases": [
    {
      "case_id": "explicit-source-code-link",
      "description": "A compact Source code label is a direct service-to-repository reference.",
      "observation": {
        "direction": "service_to_repo",
        "object_value": "https://github.com/example/app",
        "link_label": "Source code",
        "context_reconstructible": true
      },
      "expected": {
        "deterministic": "SUPPORTED",
        "strict": "SUPPORTED",
        "endpoint_status": "repository_root"
      }
    },
    {
      "case_id": "compact-repo-arrow-link",
      "description": "A terse repo arrow label remains an explicit source reference.",
      "observation": {
        "direction": "service_to_repo",
        "object_value": "https://github.com/example/app",
        "link_label": "repo ↗",
        "context_reconstructible": true
      },
      "expected": {
        "deterministic": "SUPPORTED",
        "strict": "SUPPORTED"
      }
    },
    {
