{
  "schema_version": 1,
  "cases": [
    {
      "case_id": "exclusive-service-with-direct-bridge",
      "description": "A shared service collision plus a direct relation between otherwise split components is prioritized for merge review.",
      "left": {
        "name": "Example",
        "claims": [
          {"kind": "service_url", "value": "https://example.com", "role": "service"},
          {"kind": "repo_url", "value": "https://github.com/example/app", "role": "project_repository"}
        ],
        "relations": [
          {"subject": ["repo_url", "https://github.com/example/app"], "predicate": "defines_schema", "object": ["collection", "com.example.post"]}
        ]
      },
      "right": {
        "name": "Example App",
        "claims": [
          {"kind": "service_url", "value": "https://example.com", "role": "service"},
          {"kind": "nsid", "value": "com.example.post", "role": "owned_nsid"}
        ]
      },
      "expected_verdict": "RECOMMEND_MERGE_REVIEW"
    },
    {
      "case_id": "service-collision-alone",
      "description": "The same service URL is an urgent collision but not enough to recommend a merge by itself.",
      "left": {"claims": [{"kind": "service_url", "value": "https://same.example", "role": "service"}]},
      "right": {"claims": [{"kind": "service_url", "value": "https://same.example", "role": "service"}]},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "owned-nsid-collision-alone",
      "description": "The same full owned NSID can also be an attribution error or ownership transfer.",
      "left": {"claims": [{"kind": "nsid", "value": "app.example.post", "role": "owned_nsid"}]},
      "right": {"claims": [{"kind": "nsid", "value": "app.example.post", "role": "owned_nsid"}]},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "shared-repository-arabica-oolong",
      "description": "A repository can contain multiple separately tracked projects.",
      "left": {
        "name": "Arabica",
        "claims": [
          {"kind": "repo_url", "value": "https://github.com/arabica-social/arabica", "role": "project_repository"},
          {"kind": "service_url", "value": "https://arabica.social", "role": "service"}
        ]
      },
      "right": {
        "name": "Oolong",
        "claims": [
          {"kind": "repo_url", "value": "https://github.com/arabica-social/arabica", "role": "project_repository"},
          {"kind": "service_url", "value": "https://oolong.social", "role": "service"}
        ]
      },
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "operator-separate",
      "description": "An active operator decision is a hard guard.",
      "left": {
        "project_key": "arabica",
        "claims": [{"kind": "repo_url", "value": "https://github.com/arabica-social/arabica", "role": "project_repository"}],
        "separate_project_keys": ["oolong"]
      },
      "right": {
        "project_key": "oolong",
        "claims": [{"kind": "repo_url", "value": "https://github.com/arabica-social/arabica", "role": "project_repository"}]
      },
      "expected_verdict": "KEEP_SEPARATE"
    },
    {
      "case_id": "shared-organization-account",
      "description": "An organization account can represent multiple projects.",
      "left": {"claims": [{"kind": "did", "value": "did:plc:org", "role": "organization_account"}]},
      "right": {"claims": [{"kind": "did", "value": "did:plc:org", "role": "organization_account"}]},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "dedicated-project-account-alone",
      "description": "A shared dedicated project account is a strong collision, but role error remains possible.",
      "left": {"claims": [{"kind": "did", "value": "did:plc:project", "role": "project_account"}]},
      "right": {"claims": [{"kind": "did", "value": "did:plc:project", "role": "project_account"}]},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "fork-relation",
      "description": "A fork is routed outside ordinary duplicate-record evaluation.",
      "left": {"claims": [{"kind": "repo_url", "value": "https://github.com/example/upstream", "role": "project_repository"}]},
      "right": {"claims": [{"kind": "repo_url", "value": "https://github.com/example/upstream", "role": "project_repository"}]},
      "flags": ["fork"],
      "expected_verdict": "NOT_EVALUATED"
    },
    {
      "case_id": "successor-relation",
      "description": "A successor relation needs temporal project review before merge.",
      "left": {"name": "DateSky"},
      "right": {"name": "Nomare"},
      "flags": ["successor"],
      "expected_verdict": "NOT_EVALUATED"
    },
    {
      "case_id": "shared-namespace-not-full-claim",
      "description": "Sibling collections in one namespace are a discovery signal, not a duplicate record verdict.",
      "left": {"claims": [{"kind": "nsid", "value": "com.example.post", "role": "owned_nsid"}]},
      "right": {"claims": [{"kind": "nsid", "value": "com.example.profile", "role": "owned_nsid"}]},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "candidate-repository-and-name",
      "description": "Candidate repository and name overlap remain discovery-only.",
      "left": {
        "name": "Example",
        "claims": [{"kind": "repo_url", "value": "https://github.com/example/app", "role": "project_repository", "classification": "candidate"}]
      },
      "right": {
        "name": "Example",
        "claims": [{"kind": "repo_url", "value": "https://github.com/example/app", "role": "project_repository", "classification": "candidate"}]
      },
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "same-root-domain-only",
      "description": "Projects under one root domain are not necessarily duplicates.",
      "left": {"name": "Tool A", "website_url": "https://a.example.com"},
      "right": {"name": "Tool B", "website_url": "https://b.example.com"},
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "exact-owned-collection-fragment",
      "description": "A collection-only record whose full owned collection is already contained by a broader record is prioritized for absorption review.",
      "left": {
        "name": "Example Fragment",
        "seed_type": "nsid",
        "seed_value": "com.example.flow",
        "claims": [{"kind": "nsid", "value": "com.example.flow", "role": "owned_nsid"}]
      },
      "right": {
        "name": "Example",
        "claims": [
          {"kind": "nsid", "value": "com.example.flow", "role": "owned_nsid"},
          {"kind": "nsid", "value": "com.example.run", "role": "owned_nsid"}
        ]
      },
      "expected_verdict": "RECOMMEND_MERGE_REVIEW"
    },
    {
      "case_id": "named-collection-fragment-with-encompassing-service",
      "description": "A collection-only subsystem under the same authority can be absorbed by a named encompassing project with an independent service.",
      "left": {
        "name": "GainForest Soundscape",
        "seed_type": "nsid",
        "seed_value": "app.gainforest.ac.soundscape",
        "claims": [{"kind": "nsid", "value": "app.gainforest.ac.soundscape", "role": "owned_nsid"}]
      },
      "right": {
        "name": "GainForest",
        "claims": [
          {"kind": "nsid", "value": "app.gainforest.post", "role": "owned_nsid"},
          {"kind": "service_url", "value": "https://gainforest.app", "role": "service"}
        ]
      },
      "expected_verdict": "RECOMMEND_MERGE_REVIEW"
    },
    {
      "case_id": "sibling-seed-fragment-with-project-repository",
      "description": "A collection-only record and an implementation record with sibling registration origins and the same project name are prioritized for absorption review.",
      "left": {
        "name": "Postgame",
        "seed_type": "nsid",
        "seed_value": "at.postgame.badge",
        "claims": [{"kind": "repo_url", "value": "https://github.com/example/postgame", "role": "project_repository"}]
      },
      "right": {
        "name": "Postgame",
        "seed_type": "nsid",
        "seed_value": "at.postgame.list",
        "claims": [
          {"kind": "nsid", "value": "at.postgame.list", "role": "owned_nsid"},
          {"kind": "nsid", "value": "at.postgame.list.item", "role": "owned_nsid"}
        ]
      },
      "expected_verdict": "RECOMMEND_MERGE_REVIEW"
    },
    {
      "case_id": "independent-sibling-collection-projects",
      "description": "Sibling namespaces do not imply absorption when neither record provides an encompassing independent project surface.",
      "left": {
        "name": "Egg",
        "claims": [{"kind": "nsid", "value": "ai.example.egg", "role": "owned_nsid"}]
      },
      "right": {
        "name": "Log",
        "claims": [{"kind": "nsid", "value": "ai.example.log", "role": "owned_nsid"}]
      },
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "collection-use-alone-is-not-absorption",
      "description": "A repository using a collection is composition evidence, not sufficient evidence that the collection-only project is a fragment of the repository project.",
      "left": {
        "name": "Graph Vocabulary",
        "claims": [{"kind": "nsid", "value": "com.example.graph.item", "role": "owned_nsid"}]
      },
      "right": {
        "name": "Graph Client",
        "claims": [
          {"kind": "nsid", "value": "com.example.client.record", "role": "owned_nsid"},
          {"kind": "repo_url", "value": "https://github.com/example/graph-client", "role": "project_repository"}
        ],
        "relations": [{
          "subject": ["repo_url", "https://github.com/example/graph-client"],
          "predicate": "uses_collection",
          "object": ["nsid", "com.example.graph.item"]
        }]
      },
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "candidate-service-name-is-not-absorption-evidence",
      "description": "A host-like project name obtained alongside an unconfirmed service candidate does not connect a collection record to the service project.",
      "left": {
        "name": "directory.example",
        "claims": [
          {"kind": "nsid", "value": "example.directory.alice.post", "role": "owned_nsid"},
          {"kind": "service_url", "value": "https://directory.example", "role": "service", "classification": "candidate"}
        ]
      },
      "right": {
        "name": "Directory",
        "claims": [
          {"kind": "nsid", "value": "example.directory.documentation", "role": "owned_nsid"},
          {"kind": "service_url", "value": "https://directory.example", "role": "service"}
        ]
      },
      "expected_verdict": "REVIEW"
    },
    {
      "case_id": "shared-lexicon-is-not-a-fragment",
      "description": "A project explicitly classified as a shared Lexicon is not absorbed merely because another service uses the same authority.",
      "left": {
        "name": "Community Lexicon",
        "category": "lexicon",
        "claims": [{"kind": "nsid", "value": "community.example.post", "role": "owned_nsid"}]
      },
      "right": {
        "name": "Example App",
        "claims": [
          {"kind": "nsid", "value": "community.example.profile", "role": "owned_nsid"},
          {"kind": "service_url", "value": "https://app.example.community", "role": "service"}
        ]
      },
      "expected_verdict": "REVIEW"
    }
  ]
}
