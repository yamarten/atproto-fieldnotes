{
  "collection_inventory": {
    "url": "https://collectiondata.usounds.work/collection_count_view",
    "builtin_prefixes": [
      "app.bsky.",
      "chat.bsky.",
      "com.atproto."
    ],
    "infra_keywords": [
      "pds",
      "relay",
      "feed",
      "labeler",
      "moderation",
      "index",
      "firehose",
      "jetstream"
    ]
  },
  "github_repo_search": {
    "enabled": true,
    "queries": [
      "atproto OR \"AT protocol\" OR atprotocol fork:false archived:false"
    ],
    "pages": 10,
    "per_page": 100
  },
  "tangled_repo_discovery": {
    "enabled": true,
    "ufos_api_url": "https://ufos-api.microcosm.blue/records",
    "collection": "sh.tangled.repo",
    "limit": 100,
    "optional_adapters": {
      "timeline": {"enabled": false, "url": "https://tangled.org/timeline"},
      "community_search": {"enabled": false, "url": "https://tangled-search.bigmoves.deno.net/"},
      "bluesky_bot": {"enabled": false, "handle": "stitch.selfhosted.social"}
    }
  }
}
