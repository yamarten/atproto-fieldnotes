{
  "custom_multi_tenant_suffixes": [
    "lexicon.community",
    "avaast.app",
    "tomo-x.win",
    "smokesignal.tools",
    "microcosm.blue",
    "atmo.tools",
    "henry.ink",
    "tokimeki.tech",
    "whey.party",
    "suibari.com"
  ],
  "collection_inventory": {
    "url": "https://collectiondata.usounds.work/collection_count_view",
    "builtin_prefixes": [
      "app.bsky.",
      "chat.bsky.",
      "com.atproto."
    ],
    "infra_keywords": [
      "pds",
      "relay",
      "feed",
      "labeler",
      "moderation",
      "index",
      "firehose",
      "jetstream"
    ]
  },
  "github_repo_search": {
    "enabled": true,
    "queries": [
      "atproto OR \"AT protocol\" OR atprotocol fork:false archived:false"
    ],
    "pages": 1,
    "per_page": 50
  },
  "tangled_repo_discovery": {
    "enabled": true,
    "ufos_api_url": "https://ufos-api.microcosm.blue/records",
    "collection": "sh.tangled.repo",
    "limit": 100
  }
}
