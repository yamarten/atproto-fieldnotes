#compdef project-registry

local -a subcommands tracking_states seed_types llm_api_styles llm_reasoning_efforts review_kinds
local -a promotion_kinds

subcommands=(
  'init-db:Explicitly initialize a schema v2 registry database'
  'add-seed:Register one manual seed'
  'enrich:Enrich one or more projects'
  'show:Show registered projects'
  'validate-app-record-export:Write a read-only app entry readiness report'
  'export-app-records:Export explicitly selected app entry records'
  'explain:Explain saved registry conclusions'
  'review-queue:List projects that deserve human review'
  'promotion-queue:List unintroduced projects worth showcasing'
  'review-stalled:Suggest lower-frequency tracking or revival'
  'review-ignore:Suggest low-value fork repos and derivative tools for ignore'
  'review-out-of-scope:Suggest related projects that are outside the survey scope'
  'import-seed-list:Import a mixed text seed list'
  'sync-introduced:Mark matching projects as introduced from Bluesky posts'
  'sync-github-search:Search GitHub repositories and import repo seeds'
  'sync-collections:Fetch and import collection inventory'
  'sync-bluesky-lexicons:Import official Bluesky record lexicons'
  'sync-semble-collections:Sync fixed Semble collections into project seeds'
  'sync-tangled-repos:Sync the recent UFOs Tangled repository rolling window'
  'replay-investigation:Replay a saved investigation without network access'
  'benchmark-investigation:Benchmark an investigation fixture corpus'
  'export-investigation-fixture:Export a sanitized saved investigation fixture'
  'export-llm-evaluation-corpus:Export fixed triage evidence from saved runs'
  'evaluate-llm-corpus:Run one model configuration against a fixed corpus'
  'compare-llm-evaluation-reports:Compare two complete LLM evaluation reports'
  'export-repository-analysis-corpus:Export fixed repository analysis material from saved runs'
  'evaluate-repository-analysis-corpus:Run one model configuration against fixed repository material'
  'compare-repository-analysis-reports:Compare two repository analysis reports'
  'export-relation-assessment-corpus:Export current relation assessment material read-only'
  'export-recollection-relation-assessment-corpus:Export exact-component cases from a recollection report'
  'evaluate-relation-assessment-corpus:Run the predicate-specific relation assessor against a fixed corpus'
  'verify-service:Verify a service with static, deep-page, or browser checks'
  'repair-db:Normalize stored data and refresh derived fields'
  'audit-url-fields:Report URL field usage and invariant violations'
  'audit-trust-graph:Report trust-graph confirmation issues'
  'migrate-repository-trust:Review or apply repository relation migration'
  'compare-trust-policy:Compare current and role-aware trust policies'
  'compare-collector-relation-policy:Compare current and direction-aware collector relation policies'
  'compare-project-repository-context:Recollect bounded project repository link context'
  'compare-project-repository-recollection:Recollect pre-migration page repository claims read-only'
  'materialize-project-repository-review:Apply reviewed repository relations to a new shadow database'
  'compare-project-repository-migration:Compare source repository role and relation migration'
  'compare-project-site-migration:Compare Website and repository homepage inputs for project site migration'
  'compare-merge-policy:Compare current merge candidates and role-aware review policy'
  'compare-identifier-storage:Prototype noncurrent identifier and adoption storage'
  'repair-trust-graph:Recompute stored trust graph details'
  'cleanup-storage-payloads:Compact stored service and investigation payloads'
  'cleanup-workspace-temp:Delete stale SQLite copies under .tmp'
  'compress-investigation-history:Compress investigation history JSON'
  'prune-investigation-history:Delete old investigation history'
  'set-tracking-state:Set tracking state for one project'
  'set-separate:Mark two projects as distinct'
  'block-identifier:Block one identifier from being reattached'
  'defer-identifier:Temporarily downgrade one identifier'
  'defer-promotion:Temporarily hide one project from promotion queue'
  'audit-source-config:Audit registered projects after suffix changes'
  'split-project:Split one identifier out into a new project'
  'inspect-merge-pair:Inspect merge evidence for one pair'
  'merge:Merge one project into another'
)

tracking_states=(active stable stalled out_of_scope archived ignore)
seed_types=(nsid repo_url service_url)
llm_api_styles=(auto chat responses completions)
llm_reasoning_efforts=(none minimal low medium high)
review_kinds=(
  service_candidate_needs_confirmation
  candidate_repo_needs_confirmation
  llm_manual_review_recommended
  service_now_usable_but_needs_editorial_review
  more_evidence_than_current_classification
  stale_metadata_with_recent_activity
  service_status_unverified_but_promising
  category_recheck_needed
  external_lexicon_dependency_needs_review
  high_information_density
  many_identity_candidates
)
promotion_kinds=(
  service_surface_confirmed
  service_candidate_needs_validation
  lexicon_publisher_confirmed
  technical_insight_candidate
)

_project_registry_tracking_states() {
  _values -s ' ' 'tracking state' ${tracking_states[@]}
}

_project_registry_seed_types() {
  _values 'seed type' ${seed_types[@]}
}

_project_registry_llm_api_styles() {
  _values 'LLM API style' ${llm_api_styles[@]}
}

_project_registry_llm_reasoning_efforts() {
  _values 'LLM reasoning effort' ${llm_reasoning_efforts[@]}
}

_project_registry_common_llm_options() {
  _arguments -S \
    '--llm-endpoint[OpenAI-compatible LLM endpoint or base URL]:endpoint:' \
    '--llm-model[Model name for the LLM endpoint]:model:' \
    '--llm-api-key[Optional API key for the LLM endpoint]:api key:' \
    "--llm-api-style[LLM endpoint API style preference]:api style:_project_registry_llm_api_styles" \
    "--llm-reasoning-effort[Optional reasoning or thinking effort]:effort:_project_registry_llm_reasoning_efforts"
}

local context state state_descr line
typeset -A opt_args

_arguments -C -S \
  '1:project-registry command:->command' \
  '*::argument:->args'

case "$state" in
  command)
    _describe -t commands 'project-registry command' subcommands
    return
    ;;
  args)
    ;;
  *)
    return
    ;;
esac

local cmd="${line[1]}"

case "$cmd" in
  init-db)
    _arguments -S \
      '--db-path[SQLite DB path]:path:_files'
    ;;
  add-seed)
    _arguments -S \
      '1:seed:' \
      "--type[Override automatic seed type detection]:seed type:_project_registry_seed_types" \
      '(-p --project-key)'{-p,--project-key}'[Attach the seed to an existing project key]:project key:'
    ;;
  enrich)
    _arguments -S \
      '(-p --project-key --seed --all)'{-p,--project-key}'[Target one project key]:project key:' \
      '(-p --project-key --seed --all)--seed[Target by known seed value]:seed:' \
      '(-p --project-key --seed --all)--all[Enrich all registered projects]' \
      "--type[Required when --seed is ambiguous]:seed type:_project_registry_seed_types" \
      '(-A --all-tracking-states)--tracking-states+[When used with --all, restrict to these tracking states]:tracking states:_project_registry_tracking_states' \
      '(-A --all-tracking-states)'{-A,--all-tracking-states}'[Ignore tracking state filters and enrich every project]' \
      '--include-stable[Include projects marked stable]' \
      '--include-stalled[Include projects marked stalled]' \
      '--include-out-of-scope[Include projects outside the survey scope]' \
      '--include-archived[Include projects marked archived]' \
      '--include-ignore[Include projects marked ignore]' \
      '--new-only[Only enrich projects that have never been enriched]' \
      '--retry-failures[Only enrich projects whose previous enrich left last_run_errors]' \
      '--fail-fast[Stop after the first failed project]' \
      '--run-id[Use this resumable checkpoint run ID]:run id:' \
      '--resume-run[Resume this checkpoint run ID]:run id:' \
      '--checkpoint-path[Override the checkpoint JSON path]:path:_files' \
      '--no-checkpoint[Disable resumable checkpoint writing]' \
      '--deep-investigation[Probe discovered resource or docs pages before LLM review]' \
      "--llm-endpoint[OpenAI-compatible LLM endpoint or base URL]:endpoint:" \
      "--llm-model[Model name for the LLM endpoint]:model:" \
      "--llm-api-key[Optional API key for the LLM endpoint]:api key:" \
      "--llm-api-style[LLM endpoint API style preference]:api style:_project_registry_llm_api_styles" \
      "--llm-reasoning-effort[Optional reasoning or thinking effort]:effort:_project_registry_llm_reasoning_efforts" \
      '--llm-max-output-tokens[Maximum output tokens for each LLM request]:count:' \
      '--llm-triage-prompt-suffix-file[Append triage rules and record their content hash]:path:_files'
    ;;
  show)
    _arguments -S \
      '(-p --project-key --seed --all)'{-p,--project-key}'[Target one project key]:project key:' \
      '(-p --project-key --seed --all)--seed[Target by known seed value]:seed:' \
      '(-p --project-key --seed --all)--all[Show all projects]' \
      "--type[Required when --seed is ambiguous]:seed type:_project_registry_seed_types" \
      '--tracking-states+[Restrict output to these tracking states]:tracking states:_project_registry_tracking_states' \
      '--format[Output format]:format:(text json)'
    ;;
  validate-app-record-export)
    _arguments -S \
      '--db-path[Source schema v3 SQLite database opened read-only]:database file:_files' \
      '--output[JSON readiness report path]:report file:_files'
    ;;
  export-app-records)
    _arguments -S \
      '--db-path[Source schema v3 SQLite database opened read-only]:database file:_files' \
      '--manifest[Publication manifest JSON path]:manifest file:_files' \
      '--output[Validated multi-record JSON path]:output file:_files'
    ;;
  explain)
    _arguments -S \
      '(-p --project-key)'{-p,--project-key}'[Target one project key]:project key:' \
      '--topic[Restrict to one explanation topic]:topic:(all service_status ownership contribution merge_candidate trust)' \
      '--format[Output format]:format:(text json)'
    ;;
  review-queue)
    _arguments -S \
      '--tracking-states+[Restrict review queue to these tracking states]:tracking states:_project_registry_tracking_states' \
      "--kinds+[Restrict to specific review kinds]:kind:(${review_kinds[*]})" \
      '--limit[Maximum number of projects to return]:count:' \
      '--interactive[Step through review items interactively]'
    ;;
  promotion-queue)
    _arguments -S \
      '--tracking-states+[Restrict promotion queue to these tracking states]:tracking states:_project_registry_tracking_states' \
      "--kinds+[Restrict to specific promotion kinds]:kind:(${promotion_kinds[*]})" \
      '--limit[Maximum number of projects to return]:count:' \
      '--include-personal-tools[Include category=personal_tool candidates]' \
      '--interactive[Step through promotion items interactively]'
    ;;
  review-stalled)
    _arguments -S \
      '--inactivity-days[Flag projects whose collection activity has been quiet this many days]:days:' \
      '--max-enrich-age-days[Only consider stalled downgrades for projects enriched within this many days]:days:' \
      '--execute[Apply the suggested updates]' \
      '--interactive[Step through stalled-review candidates interactively]' \
      '--note[Optional tracking note]:note:'
    ;;
  review-ignore)
    _arguments -S \
      '--tracking-states+[Restrict review-ignore to these tracking states]:tracking states:_project_registry_tracking_states' \
      '--limit[Maximum number of candidates to return or apply]:count:' \
      '--execute[Apply the suggested updates]' \
      '--interactive[Step through ignore candidates interactively]' \
      "--note[Optional tracking note]:note:" \
      '--note-reason[Preset note category]:reason:(atproto_unrelated fork_without_identity personal_experiment other)'
    ;;
  review-out-of-scope)
    _arguments -S \
      '--tracking-states+[Restrict review-out-of-scope to these tracking states]:tracking states:_project_registry_tracking_states' \
      '--limit[Maximum number of candidates to return or apply]:count:' \
      '--execute[Apply the suggested updates]' \
      '--interactive[Step through out-of-scope candidates interactively]' \
      '--note[Optional tracking note]:note:' \
      '--note-reason[Preset reason category]:reason:(auth_only client_only derivative_utility other)'
    ;;
  import-seed-list)
    _arguments -S \
      '1:path:_files' \
      '--execute[Apply imports]'
    ;;
  sync-introduced)
    _arguments -S \
      '--query[Bluesky post search query]:query:' \
      '--limit[Maximum number of posts to inspect]:count:' \
      '--max-pages[Maximum number of paginated search requests]:count:' \
      '--lookback-days[Override the configured initial lookback]:days:' \
      '--incremental[Resume from the last successful sync]' \
      '--no-incremental[Ignore stored sync state]' \
      '--all-history[Ignore the saved watermark and initial lookback]' \
      '--execute[Apply introduced flags]'
    ;;
  sync-github-search)
    _arguments -S \
      '--query[Override one GitHub repository search query]:query:' \
      '--pages[How many result pages to scan]:count:' \
      '--per-page[How many results to fetch per page]:count:' \
      '--lookback-days[Only consider repos updated within this many days]:days:' \
      '--all-history[Disable updated_at lookback]' \
      '--incremental[Resume each query from its last successful sync]' \
      '--no-incremental[Ignore stored sync state]' \
      '--execute[Apply imports]' \
      '--create-unmatched[Create new projects for unknown GitHub repos]' \
      '--no-create-unmatched[List only without creating unknown GitHub repos]' \
      '--screen-unmatched[Fetch metadata before creating unmatched repos]'
    ;;
  sync-collections)
    _arguments -S \
      '--source-url[Override the collection inventory URL]:url:' \
      '--execute[Apply imports]' \
      '--create-unmatched[Create new projects for unmatched imported collections]' \
      '--no-create-unmatched[List only without creating unmatched collections]' \
      '--lookback-days[Only consider collections whose min timestamp is within this many days]:days:' \
      '--incremental[Use the last successful inventory watermark]' \
      '--no-incremental[Ignore stored sync state]' \
      '--all-history[Ignore the saved watermark and initial lookback]' \
      '--save-path[Optional path to save the fetched JSON payload]:path:_files' \
      '--max-items[Maximum number of fetched entries to process]:count:'
    ;;
  sync-bluesky-lexicons)
    _arguments -S \
      '--execute[Apply owned NSIDs]'
    ;;
  sync-semble-collections)
    _arguments -S \
      '--pages[How many collection pages to scan per tracked collection]:count:' \
      '--per-page[How many collection cards to fetch per page]:count:' \
      '--lookback-days[Only consider cards updated within this many days]:days:' \
      '--all-history[Disable updated_at lookback]' \
      '--incremental[Resume each collection from its last successful sync]' \
      '--no-incremental[Ignore stored sync state]' \
      '--execute[Apply imports]' \
      '--create-unmatched[Create new projects for unknown seeds discovered from cards]' \
      '--no-create-unmatched[List only without creating unknown seeds]'
    ;;
  sync-tangled-repos)
    _arguments -S \
      '--execute[Apply imports]' \
      '--create-unmatched[Create projects for unmatched atproto-relevant repos]' \
      '--no-create-unmatched[Do not create unmatched projects]' \
      '--incremental[Use the saved time_us watermark]' \
      '--no-incremental[Ignore and do not update the saved watermark]' \
      '--all-history[Ignore the saved watermark; source remains a rolling window]' \
      '--max-items[Maximum number of rolling-window entries to process]:count:'
    ;;
  replay-investigation)
    _arguments -S \
      '(-p --project-key --run-id)--run-id[Saved investigation run ID]:run id:' \
      '(--run-id)'{-p,--project-key}'[Replay the latest run for one project]:project key:'
    ;;
  benchmark-investigation)
    _arguments -S '--path[Fixture file or directory]:path:_files'
    ;;
  export-investigation-fixture)
    _arguments -S \
      '--run-id[Saved investigation run ID]:run id:' \
      '--case-id[Fixture case ID]:case id:' \
      '--output[Write fixture JSON to this path]:path:_files'
    ;;
  export-llm-evaluation-corpus)
    _arguments -S \
      '--db-path[Source SQLite DB opened read-only]:path:_files' \
      '--output[Output corpus JSON path]:path:_files' \
      '--limit[Maximum number of cases]:count:' \
      '--library-min[Minimum library cases to prioritize]:count:' \
      '--category-min[Minimum cases per available reference category]:count:'
    ;;
  evaluate-llm-corpus)
    _arguments -S \
      '--corpus[Fixed corpus JSON path]:path:_files' \
      '--labels[Reviewed expected-output labels JSON path]:path:_files' \
      '--prompt-variant[Prompt variant label]:name:' \
      '--prompt-suffix-file[Evaluation-only prompt suffix]:path:_files' \
      '--repository-analysis-report[Overlay normalized repository analysis results]:path:_files' \
      '--output[Structured report JSON path]:path:_files' \
      '*--case-id[Run only this case ID]:case id:' \
      '--repeat[Runs per case]:count:' \
      '--current-profile-mode[Include saved Qwen profile in evidence]:mode:(without with)' \
      '--output-cap[Maximum output tokens]:count:' \
      '--runtime[Runner name and version]:runtime:' \
      '--quantization[Quantization label]:quantization:' \
      '--llm-endpoint[OpenAI-compatible LLM endpoint or base URL]:endpoint:' \
      '--llm-model[Model name for the LLM endpoint]:model:' \
      '--llm-api-key[Optional API key for the LLM endpoint]:api key:' \
      '--llm-api-style[LLM endpoint API style preference]:api style:_project_registry_llm_api_styles' \
      '--llm-reasoning-effort[Optional reasoning or thinking effort]:effort:_project_registry_llm_reasoning_efforts' \
      '--reasoning-observation[Runtime observation for the requested reasoning setting]:status:(applied ignored not_checked)' \
      '--reasoning-observation-note[Short non-secret runtime evidence]:note:'
    ;;
  compare-llm-evaluation-reports)
    _arguments -S \
      '--baseline[Baseline report JSON path]:path:_files' \
      '--candidate[Candidate report JSON path]:path:_files' \
      '--output[Comparison JSON path]:path:_files'
    ;;
  export-repository-analysis-corpus)
    _arguments -S \
      '--db-path[Source SQLite DB opened read-only]:path:_files' \
      '--output[Output corpus JSON path]:path:_files' \
      '--limit[Maximum number of cases]:count:'
    ;;
  evaluate-repository-analysis-corpus)
    _arguments -S \
      '--corpus[Fixed corpus JSON path]:path:_files' \
      '--output[Structured report JSON path]:path:_files' \
      '*--case-id[Run only this case ID]:case id:' \
      '--repeat[Runs per case]:count:' \
      '--output-cap[Maximum output tokens]:count:' \
      '--runtime[Runner name and version]:runtime:' \
      '--quantization[Quantization label]:quantization:' \
      '--llm-endpoint[OpenAI-compatible LLM endpoint or base URL]:endpoint:' \
      '--llm-model[Model name for the LLM endpoint]:model:' \
      '--llm-api-key[Optional API key for the LLM endpoint]:api key:' \
      '--llm-api-style[LLM endpoint API style preference]:api style:_project_registry_llm_api_styles' \
      '--llm-reasoning-effort[Optional reasoning or thinking effort]:effort:_project_registry_llm_reasoning_efforts' \
      '--reasoning-observation[Runtime observation for the requested reasoning setting]:status:(applied ignored not_checked)' \
      '--reasoning-observation-note[Short non-secret runtime evidence]:note:'
    ;;
  compare-repository-analysis-reports)
    _arguments -S \
      '--baseline[Baseline report JSON path]:path:_files' \
      '--candidate[Candidate report JSON path]:path:_files' \
      '--output[Comparison JSON path]:path:_files'
    ;;
  evaluate-relation-assessment-corpus)
    _arguments -S \
      '--corpus[Fixed corpus JSON path]:path:_files' \
      '--output[Structured report JSON path]:path:_files' \
      '*--case-id[Run only this case ID]:case id:' \
      '--repeat[Runs per case]:count:' \
      '--output-cap[Maximum output tokens]:count:' \
      '--support-evidence-mode[Evidence requirement for SUPPORTED]:mode:(both_endpoints direct_any)' \
      '--runtime[Runner name and version]:runtime:' \
      '--quantization[Quantization label]:quantization:' \
      '--llm-endpoint[OpenAI-compatible LLM endpoint or base URL]:endpoint:' \
      '--llm-model[Model name for the LLM endpoint]:model:' \
      '--llm-api-key[Optional API key for the LLM endpoint]:api key:' \
      '--llm-api-style[LLM endpoint API style preference]:api style:_project_registry_llm_api_styles' \
      '--llm-reasoning-effort[Optional reasoning or thinking effort]:effort:_project_registry_llm_reasoning_efforts'
    ;;
  export-relation-assessment-corpus)
    _arguments -S \
      '--db-path[Source SQLite DB opened read-only]:path:_files' \
      '--output[Output corpus JSON path]:path:_files'
    ;;
  export-recollection-relation-assessment-corpus)
    _arguments -S \
      '--report[Bounded project repository recollection JSON report]:path:_files' \
      '--output[Output corpus JSON path]:path:_files'
    ;;
  verify-service)
    _arguments -S \
      '(-p --project-key --seed)'{-p,--project-key}'[Target one project key]:project key:' \
      '(-p --project-key --seed)--seed[Target by known seed value]:seed:' \
      '--type[Required when --seed is ambiguous]:seed type:_project_registry_seed_types' \
      '--url[Override the project service URL]:url:' \
      '--lane[Verification method]:method:(static deep browser)' \
      '--execute[Apply the result and save an investigation run]'
    ;;
  repair-db)
    _arguments -S \
      '--execute[Apply normalization and derived-field refreshes]'
    ;;
  audit-url-fields)
    _arguments -S \
      '--example-limit[Maximum anomaly examples per kind]:count:'
    ;;
  audit-trust-graph)
    _arguments -S \
      '--example-limit[Maximum issue examples]:count:'
    ;;
  migrate-repository-trust)
    _arguments \
      '--db-path[Existing database]:database:_files' \
      '--output[Plan or execution result JSON]:output:_files' \
      '--execute-plan[Reviewed migration plan]:plan:_files' \
      '--archive[Archive all legacy edges without restoring judgments]:new archive:_files'
    ;;
  compare-trust-policy)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured comparison report JSON path]:report file:_files' \
      '--example-limit[Maximum v1/shadow delta examples per profile]:count:'
    ;;
  compare-collector-relation-policy)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured comparison report JSON path]:report file:_files' \
      '--example-limit[Maximum examples per verdict]:count:'
    ;;
  compare-project-repository-context)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured current-page comparison report JSON path]:report file:_files' \
      '--page-limit[Maximum distinct current pages to fetch]:count:' \
      '--timeout[Per-page fetch timeout in seconds]:seconds:'
    ;;
  compare-project-repository-recollection)
    _arguments -S \
      '--legacy-db-path[Pre-migration registry database opened read-only]:database file:_files' \
      '--db-path[Current registry database opened read-only]:database file:_files' \
      '--output[Structured bounded recollection report JSON path]:report file:_files' \
      '--page-limit[Maximum distinct current pages to fetch]:count:' \
      '--timeout[Per-page fetch timeout in seconds]:seconds:' \
      '--concurrency[Maximum concurrent page fetches]:count:' \
      '--retries[Retries after an empty fetch failure]:count:'
    ;;
  materialize-project-repository-review)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--materialized-db[New shadow database receiving reviewed decisions]:database file:_files' \
      '--review-manifest[Fixed operator review manifest]:JSON file:_files' \
      '--output[Structured shadow materialization report JSON path]:report file:_files'
    ;;
  compare-project-repository-migration)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured migration comparison report JSON path]:report file:_files' \
      '--example-limit[Maximum examples per disposition]:count:' \
      '--materialized-db[New shadow database receiving the projected migration]:database file:_files'
    ;;
  compare-project-site-migration)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured migration comparison report JSON path]:report file:_files' \
      '--example-limit[Maximum examples per disposition]:count:' \
      '--materialized-db[New shadow database receiving reviewed decisions]:database file:_files' \
      '--review-manifest[Reviewed decision manifest]:JSON file:_files'
    ;;
  compare-merge-policy)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured comparison report JSON path]:report file:_files' \
      '--domain-overrides[Domain overrides when not beside the DB checkout]:JSON file:_files' \
      '--example-limit[Maximum examples per verdict]:count:'
    ;;
  compare-identifier-storage)
    _arguments -S \
      '--db-path[Existing registry database opened read-only]:database file:_files' \
      '--output[Structured prototype report JSON path]:report file:_files' \
      '--example-limit[Maximum migration audit examples per category]:count:' \
      '--materialized-db[New SQLite path for the reviewed shadow migration]:database file:_files' \
      '--review-manifest[Review manifest used with the shadow migration]:manifest file:_files'
    ;;
  repair-trust-graph)
    _arguments -S \
      '--execute[Apply trust graph recomputation]' \
      '--downgrade-unsupported[Downgrade unsupported confirmed identifiers]' \
      '--example-limit[Maximum examples]:count:'
    ;;
  cleanup-storage-payloads)
    _arguments -S \
      '--execute[Rewrite payloads in one transaction]' \
      '--example-limit[Maximum largest-saving examples]:count:' \
      '--vacuum[VACUUM after a successful rewrite]'
    ;;
  cleanup-workspace-temp)
    _arguments -S \
      '--older-than-hours[Delete groups whose newest artifact is at least this old]:hours:' \
      '--example-limit[Maximum deletion candidates in the report]:count:' \
      '--execute[Delete matching SQLite artifacts]'
    ;;
  compress-investigation-history)
    _arguments -S \
      '--execute[Rewrite legacy history JSON in one transaction]' \
      '--example-limit[Maximum candidate or decode-failure examples]:count:' \
      '--vacuum[VACUUM after a successful rewrite]'
    ;;
  prune-investigation-history)
    _arguments -S \
